root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,slnx,json,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# Namespaces
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_style_namespace_match_folder = true:warning
dotnet_diagnostic.IDE0130.severity = warning

# Constructors
csharp_style_prefer_primary_constructors = true:warning
dotnet_diagnostic.IDE0290.severity = warning

# Types are internal and sealed unless something outside the assembly needs them
dotnet_diagnostic.CA1515.severity = warning
dotnet_diagnostic.CA1852.severity = warning
# Test projects see internals, but they never derive from production types.
dotnet_code_quality.CA1852.ignore_internalsvisibleto = true

# var
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

[**/Migrations/*.cs]
generated_code = true

# xUnit discovers only public test classes, and test names use Method_Scenario_Expected.
[OrderFlow.*.Tests/**.cs]
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1707.severity = none
